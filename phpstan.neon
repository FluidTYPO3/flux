includes:
	- phpstan-baseline.neon

parameters:
    level: 9
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - "#no value type specified in iterable#"

        - "#^Call to an undefined method SplFileInfo\\:\\:getRelativePathname\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3Fluid\\\\Fluid\\\\Core\\\\Rendering\\\\RenderingContextInterface\\:\\:getControllerContext\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3Fluid\\\\Fluid\\\\Core\\\\Rendering\\\\RenderingContextInterface\\:\\:setControllerContext\\(\\)\\.#"
        - "#^Call to an undefined method TYPO3Fluid\\\\Fluid\\\\View\\\\ViewInterface\\:\\:getRenderingContext\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3Fluid\\\\Fluid\\\\View\\\\TemplatePaths\\:\\:toArray\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Backend\\\\View\\\\BackendLayout\\\\DataProviderContext\\:\\:getPageId\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Backend\\\\View\\\\BackendLayout\\\\DataProviderContext\\:\\:setPageId\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Core\\\\Database\\\\Query\\\\QueryBuilder\\:\\:execute\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Core\\\\Page\\\\PageRenderer\\:\\:loadRequireJsModule\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\View\\\\ViewInterface\\:\\:getRenderingContext\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\View\\\\ViewInterface\\:\\:renderSection\\(\\)\\.$#"
        - "#^Call to an undefined method TYPO3\\\\CMS\\\\Frontend\\\\ContentObject\\\\ContentObjectRenderer\\:\\:getTypoScriptFrontendController\\(\\)\\.$#"
        - "#^Call to an undefined static method FluidTYPO3\\\\Flux\\\\ViewHelpers\\\\AbstractViewHelper\\:\\:renderStatic\\(\\)\\.$#"
        - "#^Call to an undefined static method FluidTYPO3\\\\Flux\\\\ViewHelpers\\\\AbstractViewHelper\\:\\:overrideArgument\\(\\)\\.$#"

        - "#(invalid (return )?type|unknown class) Doctrine\\\\DBAL\\\\FetchMode#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\Context\\\\PageContext#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\Controller\\\\Event\\\\AfterPageColumnsSelectedForLocalizationEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\Controller\\\\Event\\\\ModifyNewContentElementWizardItemsEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\Controller\\\\Event\\\\ModifyPageLayoutContentEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\View\\\\BackendLayout\\\\Grid\\\\GridColumnItem#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\View\\\\Event\\\\PageContentPreviewRenderingEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Backend\\\\View\\\\PageLayoutView#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Configuration\\\\Event\\\\BeforeFlexFormDataStructureIdentifierInitializedEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Configuration\\\\Event\\\\BeforeFlexFormDataStructureParsedEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Core\\\\Event\\\\BootCompletedEvent#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Domain\\\\FlexFormFieldValues#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Domain\\\\RawRecord#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Domain\\\\Record#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Http\\\\JsonResponse#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Imaging\\\\IconSize#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Resource\\\\FileType#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Schema\\\\Capability\\\\TcaSchemaCapability#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Schema\\\\TcaSchemaFactory#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\Type\\\\Icon\\\\IconState#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\TypoScript\\\\TemplateService#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\TypoScript\\\\FrontendTypoScript#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Core\\\\View\\\\ViewFactoryInterface#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Controller\\\\ControllerContext#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\View\\\\ViewInterface#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Response#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Web\\\\Request#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Web\\\\Response#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Extbase\\\\Service\\\\EnvironmentService#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Fluid\\\\Core\\\\Rendering\\\\RenderingContextFactory#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Fluid\\\\View\\\\FluidViewAdapter#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Fluid\\\\View\\\\TemplateView#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Frontend\\\\Page\\\\PageInformation#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Frontend\\\\Controller\\\\TypoScriptFrontendController#"
        - "#(invalid (return )?type|unknown class) TYPO3\\\\CMS\\\\Recordlist\\\\RecordList\\\\DatabaseRecordList#"

        - "#^Class TYPO3\\\\CMS\\\\Backend\\\\View\\\\BackendLayout\\\\Grid\\\\GridColumnItem not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Backend\\\\View\\\\Drawing\\\\BackendLayoutRenderer not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Backend\\\\View\\\\PageLayoutView not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\Domain\\\\RawRecord not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\Domain\\\\Record not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\Domain\\\\FlexFormFieldValues not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\Schema\\\\Capability\\\\TcaSchemaCapability not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\Schema\\\\TcaSchemaFactory not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\TypoScript\\\\AST\\\\Node\\\\RootNode not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\TypoScript\\\\FrontendTypoScript not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\View\\\\ViewFactoryInterface not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Response not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\ResponseInterface not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Web\\\\Request not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Web\\\\Response not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Frontend\\\\Page\\\\PageInformation not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Frontend\\\\Controller\\\\TypoScriptFrontendController not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Fluid\\\\View\\\\TemplateView not found\\.$#"
        - "#^Class TYPO3Fluid\\\\Fluid\\\\Component\\\\Argument\\\\ArgumentCollection not found\\.$#"
        - "#^Class TYPO3\\\\CMS\\\\Core\\\\View\\\\ViewFactoryData not found\\.$#"
        - "#TYPO3\\\\CMS\\\\Extbase\\\\Configuration\\\\Exception\\\\NoServerRequestGivenException not found\\.$#"

        - "#TYPO3Fluid\\\\Fluid\\\\Component\\\\Argument\\\\ArgumentCollection#"
        - "#TYPO3Fluid\\\\Fluid\\\\Component\\\\Error\\\\ChildNotFoundException#"
        - "#TYPO3Fluid\\\\Fluid\\\\Core\\\\Parser\\\\Source#"
        - "#FluidTYPO3\\\\Flux\\\\ViewHelpers\\\\AbstractFormViewHelper\\:\\:overrideArgument\\(\\)#"

        - "#^Instanceof between (iterable|array) and TYPO3Fluid\\\\Fluid\\\\Component\\\\Argument\\\\ArgumentCollection will always evaluate to false\\.$#"
        - "#^Parameter \\#1 \\$templateString of method TYPO3Fluid\\\\Fluid\\\\Core\\\\Parser\\\\TemplateParser\\:\\:parse\\(\\) expects string, TYPO3Fluid\\\\Fluid\\\\Core\\\\Parser\\\\Source given\\.$#"
        - "#expects TYPO3Fluid\\\\Fluid\\\\Core\\\\Rendering\\\\RenderingContextInterface, TYPO3Fluid\\\\Fluid\\\\Core\\\\Rendering\\\\RenderingContextInterface\\|null given\\.#"
        - "#expects array\\|TYPO3\\\\CMS\\\\Core\\\\Domain\\\\RawRecord\\|TYPO3\\\\CMS\\\\Core\\\\Domain\\\\Record, TYPO3\\\\CMS\\\\Core\\\\Domain\\\\RecordInterface given\\.#"
        - "#expects TYPO3\\\\CMS\\\\Core\\\\Imaging\\\\IconSize, string\\|TYPO3\\\\CMS\\\\Core\\\\Imaging\\\\IconSize given\\.#"
        - "#expects TYPO3\\\\CMS\\\\Core\\\\Imaging\\\\IconState\\|null, TYPO3\\\\CMS\\\\Core\\\\Imaging\\\\IconState\\|TYPO3\\\\CMS\\\\Core\\\\Type\\\\Icon\\\\IconState\\|null given\\.#"
        - "#generic class SplObjectStorage (but )?does not specify its types#"
        - "#generic class DOMNodeList (but )?does not specify its types#"
        - "#generic class Symfony\\\\Component\\\\DependencyInjection\\\\ServiceLocator (but )?does not specify its types#"
        - "#generic interface TYPO3\\\\CMS\\\\Extbase\\\\Persistence\\\\QueryInterface (but )?does not specify its types#"
        - "#generic interface TYPO3\\\\CMS\\\\Extbase\\\\Persistence\\\\RepositoryInterface (but )?does not specify its types#"

        - "#Access to constant [A-Z]+ on an unknown class TYPO3\\\\CMS\\\\Core\\\\Type\\\\ContextualFeedbackSeverity\\.#"
        - "#Access to undefined constant TYPO3\\\\CMS\\\\Core\\\\Messaging\\\\FlashMessage\\:\\:#"
        - "#Access to undefined constant TYPO3\\\\CMS\\\\Core\\\\Imaging\\\\Icon\\:\\:SIZE_#"
        - "#Access to undefined constant TYPO3\\\\CMS\\\\Core\\\\Resource\\\\File\\:\\:FILETYPE_#"
        - "#Access to undefined constant TYPO3\\\\CMS\\\\Fluid\\\\View\\\\TemplatePaths\\:\\:DEFAULT_#"

        - "#^Class TYPO3\\\\CMS\\\\Backend\\\\View\\\\BackendLayout\\\\DataProviderContext constructor invoked with 0 parameters, 5 required\\.$#"
        - "#^Method TYPO3\\\\CMS\\\\Core\\\\Configuration\\\\FlexForm\\\\FlexFormTools\\:\\:convertFlexFormContentToArray\\(\\) invoked with 3 parameters, 1 required\\.$#"
        - "#^Method TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Dispatcher\\:\\:dispatch\\(\\) invoked with 2 parameters, 1 required\\.$#"
        - "#^Method TYPO3\\\\CMS\\\\Extbase\\\\Mvc\\\\Controller\\\\ControllerInterface\\:\\:processRequest\\(\\) invoked with 2 parameters, 1 required\\.$#"
        - "#^Method TYPO3\\\\CMS\\\\Core\\\\Database\\\\Connection\\:\\:lastInsertId\\(\\) invoked with 1 parameter, 0 required\\.$#"
        - "#^Cannot call method (rowCount|fetch|fetchAssociative|fetchAll|fetchAllAssociative)\\(\\) on (Doctrine\\\\DBAL\\\\Driver\\\\Statement|Doctrine\\\\DBAL\\\\Driver\\\\ResultStatement|Doctrine\\\\DBAL\\\\Result)\\|int\\.$#"
        - "#^Cannot call method getViewHelperVariableContainer\\(\\) on TYPO3Fluid\\\\Fluid\\\\Core\\\\Rendering\\\\RenderingContextInterface\\|null\\.$#"
        - "#^Call to an undefined static method TYPO3\\\\CMS\\\\Backend\\\\Utility\\\\BackendUtility\\:\\:getMovePlaceholder\\(\\)\\.$#"
        - "#^Strict comparison using === between TYPO3\\\\CMS\\\\Frontend\\\\ContentObject\\\\ContentObjectRenderer and null will always evaluate to false\\.$#"
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - Classes
        - Configuration
    excludePaths:
        - Classes/Integration/Event/AfterLocalizationControllerColumnsEventListener.php
        - Classes/Integration/Event/IsContentUsedOnPageLayoutEventListener.php
        - Classes/Integration/HookSubscribers/Preview.php
        - Classes/Integration/HookSubscribers/TableConfigurationPostProcessor.php
        - Classes/Integration/HookSubscribers/WizardItems.php
        - Classes/Integration/Overrides/*
        - Classes/Integration/PreviewView.php
        - Classes/Updates/MigrateColPosWizard.php
